---
// Every page's <head>, header, breadcrumbs and footer.
//
// All of this is emitted at build time into the raw HTML response, which is the whole
// point of 05-SEO-AEO-GEO/01-technical-gate.md: OAI-SearchBot, PerplexityBot and
// Claude-SearchBot largely do not run JavaScript, so a tag set after hydration is a tag
// they never see.
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, absoluteUrl } from '../lib/site.js';
import { trailOf } from '../lib/pages.js';
import { organizationGraph, serviceSchema, breadcrumbSchema, faqSchema } from '../lib/schema.js';

const { page, answer, faqs = [] } = Astro.props;

const canonical = absoluteUrl(page.path);
const ogImage = absoluteUrl(`/og${page.path === '/' ? '/home/' : page.path}og.png`);
const trail = trailOf(page);

// `answer` is the visible answer-block text, passed through verbatim as the Service
// description. Schema must match the visible text exactly.
const graphs = [organizationGraph(), serviceSchema(page.serviceType, answer)];
if (trail.length > 0) graphs.push(breadcrumbSchema(trail));
// FAQPage only where a real, visible FAQ renders.
if (faqs.length > 0) graphs.push(faqSchema(faqs));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{page.title}</title>
    <meta name="description" content={page.meta} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.meta} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      graphs.map((g) => (
        <script type="application/ld+json" set:html={JSON.stringify(g)} />
      ))
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <Breadcrumbs trail={trail} />

    <main id="main" class="wrap">
      <slot />

      <p class="meta-line">
        Last reviewed {SITE.lastReviewed}. Plainly publishes information, not
        recommendations, and is not a licensed property brokerage.
      </p>
    </main>

    <SiteFooter />
  </body>
</html>

---
// Not in 03-PAGE-SPECS. Added because llms.txt publishes a contact line and the header
// carries a phone number, and both need somewhere to point.
//
// Deliberately carries no address and no opening hours: 05-SEO-AEO-GEO/03-schema-templates
// forbids asserting premises this site does not have, and that applies to the visible copy
// as much as to the schema.
import UtilityLayout from '../../layouts/UtilityLayout.astro';
import NeedsSource from '../../components/NeedsSource.astro';
import { SITE, token } from '../../lib/site.js';

const phone = token(SITE.phone, 'PHONE');
const email = token(SITE.email, 'EMAIL');
---

<UtilityLayout
  title="Contact Plainly"
  description="How to reach Plainly about a valuation request, a correction to something published here, or a question about owning in Dubai. Requests get a callback in 15 minutes."
  path="/contact/"
  h1="Contact"
>
  <p>{SITE.definition}</p>

  <h2>By phone</h2>
  <p>
    <span class="pending">{phone}</span> — the number answered for valuation enquiries.
    Requests submitted through the form are called back within 15 minutes during operating
    hours.
  </p>

  <h2>By email</h2>
  <p><span class="pending">{email}</span></p>

  <h2>Requesting a valuation</h2>
  <p>
    Use the form on{' '}
    <a href="/property-valuation-dubai/">the valuation page</a> rather than emailing, because
    it captures the four details needed to start and routes straight to the licensed partner
    who produces the report.
  </p>

  <h2>Correcting something published here</h2>
  <p>
    Every figure on this site is attributed to a source and dated. If one is wrong or has gone
    stale, say which page and which figure and it will be checked against the source and
    corrected or removed.
  </p>

  <h2>What Plainly does not do</h2>
  <ul>
    <li>List or advertise properties</li>
    <li>Act as a broker, or introduce buyers and sellers for a commission</li>
    <li>Provide investment advice or projected returns</li>
    <li>Carry out valuations itself — a licensed partner does that</li>
  </ul>

  <p>
    Operating hours, and confirmation of who answers outside them, are needed before this page
    is accurate:{' '}
    <NeedsSource what="operating hours and out-of-hours arrangement for the answered number" />
  </p>
</UtilityLayout>

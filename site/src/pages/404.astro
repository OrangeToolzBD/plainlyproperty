---
// Not in 03-PAGE-SPECS. Every site needs one, and 02-ARCHITECTURE/sitemap-tree.md:52 makes
// it load-bearing here: "Never change a URL after launch. If you must, 301 the old one and
// keep it forever." A useful 404 is what catches the ones that slip through anyway.
import UtilityLayout from '../layouts/UtilityLayout.astro';
import { PAGES } from '../lib/pages.js';
---

<UtilityLayout
  title="Page not found — Plainly"
  description="That page does not exist on this site. No URL here has ever been redirected, so the address was likely mistyped. All 13 published pages are listed on this page."
  noindex={true}
  h1="That page does not exist"
>
  <p>
    Nothing has moved — this site has never redirected a URL. So either the address was
    mistyped, or a link somewhere else is wrong.
  </p>

  <h2>Everything published here</h2>
  <ul>
    {
      PAGES.filter((p) => p.path !== '/').map((p) => (
        <li>
          <a href={p.path}>{p.crumb}</a>
        </li>
      ))
    }
  </ul>

  <p>
    If you followed a link from elsewhere on this site, that is a fault worth reporting —{' '}
    <a href="/contact/">say which page it was on</a>.
  </p>
</UtilityLayout>

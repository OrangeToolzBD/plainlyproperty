const page = byPath('/blog/mortgage-broker-dubai/');

const answer =
  'Mortgage brokers in Dubai are paid 0.5–1% of the loan by the lender, not by you. That ' +
  'makes the service free at the point of use and creates an incentive worth understanding: a ' +
  'broker earns on the loan completing, which is not always the same as you borrowing the ' +
  'least.';

const faqs = [
  {
    q: 'How much does a mortgage broker cost in Dubai?',
    a:
      'Nothing directly, in the usual arrangement. The lender pays the broker 0.5–1% of the ' +
      'loan on completion. Some brokers also charge the borrower a fee; ask which model ' +
      'applies before you start, because it changes whose interest the advice serves.',
  },
  {
    q: 'Is it cheaper to go direct to the bank?',
    a:
      'Not usually in cash terms, since the broker is paid by the lender either way. Going ' +
      'direct is worth it when you already know which bank you want and meet its criteria ' +

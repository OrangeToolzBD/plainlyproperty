const page = byPath('/property-valuation-dubai/how-it-works/');

const answer =
  'Dubai property valuation works three ways: comparable sales, which prices your unit ' +
  'against recorded transactions in the same building; the income approach, which capitalises ' +
  'achieved rent; and DLD certification, which is the only one an authority will accept. The ' +
  'first is free here and returned within 24 hours.';

const faqs = [
  {
    q: 'Is there a property valuation calculator for Dubai?',
    a:
      'Calculators return a band, not a valuation. A useful one multiplies a price per square ' +
      'foot drawn from recorded transactions in your building by your unit’s size. It cannot ' +
      'see floor, view, finish or service charge, so treat the output as a starting range.',
  },
  {
    q: 'What is the difference between a valuation and an appraisal in Dubai?',
    a:
      'In practice the word that matters is "certified". A DLD-certified valuation is issued ' +
      'through the Dubai Land Department and is what banks, courts and the visa authority ' +
      'act on. Anything else is a commercial opinion, whatever it is called.',
  },
  {
    q: 'How does the income approach work for a Dubai apartment?',
    a:
      'It takes the rent the unit actually achieves, deducts running costs including the ' +
      'service charge, and capitalises the remainder at a yield drawn from comparable ' +
      'lettings. It suits a tenanted unit, where the buyer is buying an income stream rather ' +
      'than a home.',
  },
  {
    q: 'How long is a valuation good for?',
    a:
      'Only as long as the market it describes. With H1 2026 residential transactions down ' +

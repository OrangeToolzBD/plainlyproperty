---
// The mechanism that stops an unsourced figure reaching a live page.
//
// 04-DESIGN/02-page-templates.md:88 — "a [NEEDS SOURCE] marker must fail the production
// build, not silently ship."
//
// Renders visibly in staging so the gap is obvious while drafting; scripts/gate.mjs greps
// the built HTML for the marker and exits non-zero. `what` describes the missing figure so
// the person resolving it knows what to phone and ask for.
const { what } = Astro.props;
---

<span class="pending" data-needs-source={what}>[NEEDS SOURCE{what ? `: ${what}` : ''}]</span>

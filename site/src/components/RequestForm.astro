---
// B7 — request the report. Name, phone, community, property type.
// "Four fields. Every extra field costs conversions."
//
// The privacy line is not decoration. 07-COMPLIANCE/trakheesi-and-claims.md:73 — the form
// collects an owner's name, phone and property details before any engagement exists, so it
// is client data from the moment it arrives.
import { SITE } from '../lib/site.js';
import NeedsSource from './NeedsSource.astro';

const ready = SITE.formEndpoint !== null;
---

<section id="request">
  <h2>How do I request the written report?</h2>

  <p>
    Four fields. The report is a written document sent by email within 24 hours, produced by
    the licensed partner named above from transactions recorded in your building.
  </p>

  {
    ready ? (
      <form method="post" action={SITE.formEndpoint}>
        <div class="two-col">
          <div class="field">
            <label for="rf-name">Your name</label>
            <input id="rf-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="rf-phone">Phone</label>
            <input id="rf-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>

          <div class="field">
            <label for="rf-community">Community</label>
            <input id="rf-community" name="community" type="text" required />
          </div>

          <div class="field">
            <label for="rf-type">Property type</label>
            <select id="rf-type" name="propertyType" required>
              <option value="apartment">Apartment</option>
              <option value="villa">Villa</option>
              <option value="townhouse">Townhouse</option>
              <option value="plot">Plot</option>
            </select>
          </div>
        </div>

        <button type="submit">Request the written report</button>

        <p class="hint">
          Your details go to the licensed partner who produces the valuation, and are used to
          answer this request. Nothing is shared further without your consent. See the{' '}
          <a href="/privacy/">privacy notice</a>.
        </p>
      </form>
    ) : (
      <p>
        The form is not connected to a destination yet, so it is not rendered — an enquiry
        submitted into nothing is worse than no form at all, and the 15-minute callback the
        whole model depends on has nowhere to start from. Needs a form endpoint and a
        notification path: <NeedsSource what="form endpoint + enquiry notification route" />
      </p>
    )
  }
</section>
